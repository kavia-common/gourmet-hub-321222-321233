# Frontend → Backend integration
# The React app reads these at build/start time.
#
# Set this to the FastAPI base URL (no trailing slash), e.g.:
# REACT_APP_API_BASE=https://your-backend-host
REACT_APP_API_BASE=http://localhost:8000

# Optional legacy alias supported by src/api/client.js
REACT_APP_BACKEND_URL=http://localhost:8000
